<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is deliberately DISABLED.

	     This is a personal utility that reads ~/Downloads directly and drags
	     files out to arbitrary apps. Sandboxing would require security-scoped
	     bookmarks and a user-initiated folder grant for every launch.

	     If this app is ever distributed, revisit this decision: turn the
	     sandbox on and adopt security-scoped bookmarks for the Downloads
	     folder. See context_v1.md, "Standing decisions". -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
