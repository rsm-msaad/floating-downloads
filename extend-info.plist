<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Menu bar only. REQUIRED alongside app.dock.hide(): the runtime call
	     covers `npm start`, but only this key keeps the packaged .app out of
	     the Dock and out of Cmd-Tab. Both are needed. -->
	<key>LSUIElement</key>
	<true/>

	<key>CFBundleName</key>
	<string>FloatingDownloads</string>

	<key>CFBundleDisplayName</key>
	<string>FloatingDownloads</string>

	<key>CFBundleIdentifier</key>
	<string>com.merna.floatingdownloads</string>

	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>

	<key>CFBundleVersion</key>
	<string>0.1.0</string>

	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 rsm-msaad</string>
</dict>
</plist>
